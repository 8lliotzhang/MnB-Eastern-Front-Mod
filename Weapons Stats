weaponText_pps = "PPS, mass-produced lightweight submachine gun with 35-round magazine. Easy to handle and reliable, with a moderate firing rate."
weaponText_ppshBox = "PPSh with a 35-round box magazine. Rapid fire and good close-range damage, with less bulk and better reliability than the drum version."
